{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommitsDisabled",
        "helpers:pinGitHubActionDigests"
    ],
    "timezone": "Europe/Madrid",
    "schedule": ["* 0-5 * * 1"],
    "labels": ["dependencies"],
    "rangeStrategy": "pin",
    "ignoreUnstable": true,
    "packageRules": [
        {
            "description": "Group all Kotlin language/plugin updates together",
            "matchPackagePatterns": ["^org\\.jetbrains\\.kotlin"],
            "groupName": "kotlin"
        },
        {
            "description": "Group Kotest core + extensions",
            "matchPackagePatterns": ["^io\\.kotest"],
            "groupName": "kotest"
        },
        {
            "description": "Group all Testcontainers modules",
            "matchPackagePatterns": ["^org\\.testcontainers"],
            "groupName": "testcontainers"
        },
        {
            "description": "Group all Exposed (JetBrains ORM) modules",
            "matchPackagePatterns": ["^org\\.jetbrains\\.exposed"],
            "groupName": "exposed"
        },
        {
            "description": "Group Kotlinx coroutines/serialization together",
            "matchPackagePatterns": ["^org\\.jetbrains\\.kotlinx"],
            "groupName": "kotlinx"
        },
        {
            "description": "Group all GitHub Action updates (digest pinning handled by helpers:pinGitHubActionDigests preset above)",
            "matchManagers": ["github-actions"],
            "groupName": "github-actions"
        },
        {
            "description": "Group Gradle wrapper bumps",
            "matchManagers": ["gradle-wrapper"],
            "groupName": "gradle-wrapper"
        }
    ],
    "vulnerabilityAlerts": {
        "labels": ["security", "dependencies"],
        "schedule": ["at any time"]
    },
    "gradle": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": false
    },
    "dependencyDashboardTitle": "Renovate: dependency dashboard"
}
