direction: down

title: SQL Persistence Architecture {
    near: top-center
    shape: text
    style.font-size: 24
    style.bold: true
}

repo-hierarchy: Repository Hierarchy {
    style.fill: "#e3f2fd"
    style.stroke: "#1565c0"

    SqlRepository: "SqlRepository<K, R>"
    PersistentRepositoryBase: "PersistentRepositoryBase<K, R>"
    VolatileRepository: "VolatileRepository<K, R>"

    SqlRepository -> PersistentRepositoryBase: extends
    PersistentRepositoryBase -> VolatileRepository: extends
}

table-hierarchy: Table Descriptors (capability-interface segregation) {
    style.fill: "#fff3e0"
    style.stroke: "#e65100"

    LirpTableDef: "LirpTableDef<E>" {
        "persistence-agnostic descriptor (lirp-api)"
    }
    SqlTableDef: "SqlTableDef<E>" {
        "core mapping: fromRow / toParams / applyRow (lirp-sql-api)"
    }

    VersionedTableDef: "VersionedTableDef<E>" {
        style.fill: "#ffe0b2"
        "opt-in: optimistic locking — version() / bumpVersion()"
    }
    ForeignKeyAware: "ForeignKeyAware" {
        style.fill: "#ffe0b2"
        "opt-in: single-entity FKs — foreignKeys()"
    }
    JunctionAware: "JunctionAware<E>" {
        style.fill: "#ffe0b2"
        "opt-in: collection aggregates — junctionTableDefs / accessors"
    }

    SqlTableDef -> LirpTableDef: extends

    KspGenerated: "<Entity>_LirpTableDef (KSP-generated)" {
        style.fill: "#f3e5f5"
        style.stroke: "#6a1b9a"
        "implements SqlTableDef + applicable capability interfaces"
    }

    KspGenerated -> SqlTableDef: implements
    KspGenerated -> VersionedTableDef: implements (when @Version)
    KspGenerated -> ForeignKeyAware: implements (when single-entity @Aggregate)
    KspGenerated -> JunctionAware: implements (when collection @Aggregate)
}

interpreter: ExposedTableInterpreter {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
    "interpret(LirpTableDef) → ExposedTable"
}

exposed-table: ExposedTable {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
    "table + columnsByName + versionCol"
}

repo-hierarchy.SqlRepository -> table-hierarchy.SqlTableDef: drives flush via {
    style.stroke: "#666"
}
repo-hierarchy.SqlRepository -> table-hierarchy.VersionedTableDef: as? cast {
    style.stroke-dash: 3
    style.stroke: "#666"
}
repo-hierarchy.SqlRepository -> table-hierarchy.JunctionAware: as? cast {
    style.stroke-dash: 3
    style.stroke: "#666"
}

table-hierarchy.LirpTableDef -> interpreter: reads
interpreter -> exposed-table: builds
